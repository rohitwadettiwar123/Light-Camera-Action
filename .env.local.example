# ==============================================================================
# Vaishnavi's Birthday Config (Rename to .env.local)
# ==============================================================================

VITE_BIRTHDAY_NAME="Vaishnavi"
VITE_BIRTHDAY_DATE="2026-10-04"
VITE_BIRTHDAY_RELATIONSHIP="friend"
VITE_BIRTHDAY_WISHER_NAME="<MY NAME>"
VITE_BIRTHDAY_COLOR="#FF6B9D"
VITE_BIRTHDAY_INTERESTS="<her interests>"
VITE_CUSTOM_MESSAGE="<my message>"
VITE_PASSWORD_REQUIRED="true"
VITE_PASSWORD_HINT="The day we ..."

# Photos
VITE_PHOTO_1="<photo url 1>"
VITE_PHOTO_2="<photo url 2>"
VITE_PHOTO_3="<photo url 3>"
VITE_PHOTO_4="<photo url 4>"
VITE_PHOTO_5="<photo url 5>"
VITE_PHOTO_6="<photo url 6>"

# Special Memories (shown in the Heart Tree)
VITE_SPECIAL_MEMORIES="[
  {\"text\": \"That time we...\"},
  {\"text\": \"Remember when...\"}
]"

# 3D Features (Default ON)
VITE_AURORA_ENABLE="true"
VITE_PARTICLE_MORPH="true"
VITE_CONSTELLATION_ENABLE="true"
